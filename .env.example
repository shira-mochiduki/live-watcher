YOUTUBE_API_KEY=AIza...
PUBLIC_BASE_URL=https://your-live-watcher.onrender.com

# No Discord webhook is required.
CHANNELS_JSON=[{"channel_id":"UCxxxxxxxxxxxxxxxxxxxxxx"}]

CENTRAL_NODE_URL=https://your-central-node.onrender.com
CENTRAL_NODE_TOKEN=
CENTRAL_NODE_TIMEOUT_SECONDS=5
LIVE_WATCHER_INSTANCE=default

UPCOMING_POLL_SECONDS=60
UPCOMING_PRESTART_MINUTES=10
UPCOMING_AFTER_15M_SECONDS=300
UPCOMING_AFTER_1H_SECONDS=900
UPCOMING_AFTER_6H_SECONDS=3600

RESUBSCRIBE_SECONDS=43200
WEBSUB_RENEW_RATIO=0.80
WEBSUB_VERIFY_WAIT_SECONDS=120
WEBSUB_LOOP_SECONDS=30
WEBSUB_RECOVERY_SECONDS=300

RSS_FALLBACK_SECONDS=60
LIVE_PROBE_SECONDS=60

# Optional. If /var/data exists, Live Watcher automatically uses /var/data/state.db.
STATE_DB=
